Instance: SE-samordningsnummer
InstanceOf: NamingSystem
Description: "This is the Swedish Ssamordningsnummer used for identifying individuals in Sweden. It is a unique identifier assigned to each individual and is used for various administrative purposes."
Usage: #definition
* name = "Samordningsnummer"
* status = #active
* kind = #identifier
* date = "1947-01-01"
* uniqueId[0].type = #uri
* uniqueId[0].value = $samordningsnummer