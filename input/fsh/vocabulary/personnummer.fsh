Instance: SE-Personnummer
InstanceOf: NamingSystem
Description: "This is the Swedish Personal Identity Number (personnummer) used for identifying individuals in Sweden. It is a unique identifier assigned to each individual and is used for various administrative purposes."
Usage: #definition
* name = "Personnummer"
* status = #active
* kind = #identifier
* date = "1947-01-01"
* publisher = "Skatteverket"
* uniqueId[0].type = #uri
* uniqueId[0].value = $personnummer